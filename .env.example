# =============================================================================
# SignBridge AI — Environment Configuration Template
# Copy this file to .env for local configuration or reference for Render.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vite & Standalone Web Build)
# -----------------------------------------------------------------------------
# Public HTTPS URL of the backend API for browser dashboard and studio.
# In local development: http://127.0.0.1:8000
# On Render production: https://signbridge-api-mjbw.onrender.com
VITE_BACKEND_URL=https://signbridge-api-mjbw.onrender.com

# Fallback port when VITE_BACKEND_URL is not set (default: 8000)
VITE_BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# Backend (FastAPI & Uvicorn)
# -----------------------------------------------------------------------------
# Port assigned by Render runtime (read automatically from $PORT).
# In local development: 8000
PORT=8000
SIGNBRIDGE_PORT=8000

# Server bind host. Render requires 0.0.0.0. Local development defaults to 127.0.0.1.
# Automatically defaults to 0.0.0.0 when RENDER or PORT is detected.
SIGNBRIDGE_HOST=0.0.0.0

# Comma-separated list of additional permitted web origins for CORS and WebSocket.
# Standard defaults include 127.0.0.1:5173, localhost:5173, and signbridge-2mpr.onrender.com.
SIGNBRIDGE_ALLOWED_ORIGINS=https://signbridge-web.onrender.com,https://signbridge-2mpr.onrender.com

# Comma-separated list of permitted HTTP Host headers for TrustedHost middleware.
# Standard defaults include 127.0.0.1, localhost, 0.0.0.0, and *.onrender.com.
SIGNBRIDGE_TRUSTED_HOSTS=signbridge-api-mjbw.onrender.com,*.onrender.com

# Public application origin for browser WebSocket authorization.
PUBLIC_APP_ORIGIN=https://signbridge-web.onrender.com

# Model source: 'local' (filesystem) or 'huggingface' (private repository download).
# Defaults to 'huggingface' when HF_MODEL_REPO_ID is set, else 'local'.
SIGNBRIDGE_MODEL_SOURCE=huggingface

# Relative or absolute path to the validated sign model run directory.
# In local development: ml/runs/isl500-v2-remediated
# On Render cloud: /tmp/signbridge/models/isl500-v2-remediated
SIGNBRIDGE_MODEL_DIR=/tmp/signbridge/models/isl500-v2-remediated

# Whether to automatically provision/load the model at server startup (default: true).
SIGNBRIDGE_AUTO_LOAD_MODEL=true

# -----------------------------------------------------------------------------
# Hugging Face Model Provisioning (Render / Production)
# -----------------------------------------------------------------------------
# Repository ID on Hugging Face (format: namespace/repo-name).
# Example: your-org/signbridge-isl500-remediated
HF_MODEL_REPO_ID=

# Pinned immutable full 40-character Git commit hash of the model revision.
# Never use 'main' or floating tags in production.
HF_MODEL_REVISION=

# Fine-grained read-only Hugging Face access token with repo:read permission.
# Configure as a private environment variable on Render — NEVER commit into Git!
HF_TOKEN=

# Optional pre-shared authentication token for local or private testing.
# When unset, the backend auto-generates a secure 32-byte hexadecimal token.
# SIGNBRIDGE_AUTH_TOKEN=

