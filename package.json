{
  "name": "signbridge-ai",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "extension"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "assets:setup": "npm run assets:setup --workspace extension",
    "dev": "npm run dev --workspace extension",
    "build": "npm run build --workspace extension",
    "typecheck": "npm run typecheck --workspace extension",
    "test": "npm run test --workspace extension && node --test scripts/extraction-diagnostics.test.mjs",
    "test:e2e": "npm run test:e2e --workspace extension",
    "test:browser:setup": "python scripts/setup-test-browser.py",
    "validate": "npm run typecheck && npm test && npm run build",
    "backend:setup": "python scripts/setup-backend.py",
    "backend:dev": "node scripts/backend.mjs serve",
    "backend:test": "node scripts/backend.mjs test",
    "validate:all": "npm run validate && npm run backend:test && npm run test:e2e",
    "ml:extract": "node scripts/extract-dataset.mjs",
    "ml:verify-studio": "node scripts/verify-real-model.mjs"
  }
}
